# Copy this file to .env.local. Never commit real credentials.
# Use Neon's direct (non-pooler) URL here; it works for both Prisma CLI and runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Any provider that implements OpenAI's /chat/completions API.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL=""

HUGGINGFACE_API_KEY=""
QDRANT_URL=""
QDRANT_API_KEY=""

# Optional for public repositories, recommended to increase GitHub rate limits.
GITHUB_TOKEN=""
# Required to accept signed GitHub push webhooks.
GITHUB_WEBHOOK_SECRET=""

# Optional embedding configuration. Qdrant's collection dimension must match.
HUGGINGFACE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSIONS="384"
QDRANT_COLLECTION="docsmith_documents"
